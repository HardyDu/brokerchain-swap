# Set this only to an RPC endpoint that returns non-empty eth_call results for
# Pair.getReserves(). Do not put keys or wallet secrets in this file.
BROKERCHAIN_RPC_URL=http://127.0.0.1:49282
# Must match app/src/main/assets/broker_swap_deployment.json exactly.
BROKER_SWAP_PAIR=0xe1b2b75a08143abb64d7206ee52b3b3535c64af3
BROKER_SWAP_MUSDT=0x128306db0c1ff36e3093c08da855329543d69d2d
BROKER_SWAP_WBKC=0x2623d7d7dd39e8361241c9c64c9023d57d00d8a2
# Bound JSON-RPC calls so an unavailable node cannot hold HTTP workers indefinitely.
QUOTE_CACHE_RPC_TIMEOUT_MS=3000
